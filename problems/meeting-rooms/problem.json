{
  "id": "meeting-rooms",
  "title": "Săli de ședință",
  "category": "sorting",
  "difficulty": "medium",
  "statement": "Se dă o listă `intervals` de ședințe. Ședința `[start, end]` ocupă o sală de la momentul `start` până la momentul `end`, fără momentul `end` (adică intervalul `[start, end)`). Returnează numărul minim de săli necesare pentru ca toate ședințele să aibă loc.\n\nO ședință care se termină la momentul `t` și una care începe la momentul `t` pot folosi aceeași sală. Ședințele nu sunt date într-o ordine anume.",
  "examples": [
    {"input": {"intervals": [[1, 5], [2, 6], [8, 9]]}, "output": 2, "explanation": "[1, 5] și [2, 6] au loc în același timp, deci au nevoie de săli diferite; [8, 9] poate folosi oricare dintre ele."},
    {"input": {"intervals": [[1, 3], [3, 5], [5, 7]]}, "output": 1, "explanation": "Fiecare ședință începe exact când se termină cea dinainte, deci ajunge o singură sală."}
  ],
  "signature": {"function": "min_meeting_rooms", "params": [{"name": "intervals", "type": "list[list[int]]"}], "returns": "int"},
  "constraints": [
    "1 ≤ len(intervals) ≤ 10⁵",
    "0 ≤ start < end ≤ 10⁹"
  ],
  "timeLimitMs": 1000,
  "comparator": "exact",
