{
  "id": "insert-interval",
  "title": "Inserarea unui interval",
  "category": "sorting",
  "difficulty": "medium",
  "statement": "Se dă o listă `intervals` de intervale `[start, end]`, ordonată crescător după `start`, în care oricare două intervale sunt separate (nu se suprapun și nici nu se ating). Se mai dă un interval nou, `new_interval`.\n\nAdaugă intervalul nou în listă și unește-l cu toate intervalele cu care se suprapune, astfel încât rezultatul să fie tot o listă ordonată de intervale separate. Ca la unirea intervalelor, două intervale care se ating, de exemplu `[1, 4]` și `[4, 6]`, se unesc.\n\nReturnează lista rezultată, ordonată după `start`.",
  "examples": [
    { "input": { "intervals": [[1, 3], [6, 9]], "new_interval": [2, 5] }, "output": [[1, 5], [6, 9]], "explanation": "[2, 5] se suprapune cu [1, 3], iar împreună devin [1, 5]." },
    { "input": { "intervals": [[1, 2], [3, 5], [6, 7], [8, 10], [12, 16]], "new_interval": [4, 8] }, "output": [[1, 2], [3, 10], [12, 16]], "explanation": "[4, 8] acoperă parțial sau complet [3, 5], [6, 7] și [8, 10], care devin [3, 10]." }
  ],
  "signature": {
    "function": "insert",
    "params": [{ "name": "intervals", "type": "list[list[int]]" }, { "name": "new_interval", "type": "list[int]" }],
    "returns": "list[list[int]]"
  },
  "constraints": [
    "0 ≤ len(intervals) ≤ 10⁵",
    "0 ≤ start ≤ end ≤ 10⁹, pentru fiecare interval, inclusiv new_interval",
    "intervals[i][1] < intervals[i + 1][0] (ordonate și separate)"
  ],
  "timeLimitMs": 1000,
  "comparator": "exact",
  "forbiddenTerms": [
    { "term": "trei etape" },
    { "term": "trei faze" },
    { "term": "trei părți" },
    { "term": "trei bucle" },
    { "term": "o singură parcurgere" },
    { "term": "liniar" },
    { "term": "minimul", "allowedIfCode": "min\\(" },
    { "term": "maximul", "allowedIfCode": "max\\(" },
    { "term": "lista nouă", "allowedIfCode": "=\\s*\\[\\s*\\]" },
    { "term": "rezultat separat", "allowedIfCode": "=\\s*\\[\\s*\\]" }
  ],
  "tests": [
    { "id": "basic-example", "group": "basic", "input": { "intervals": [[1, 3], [6, 9]], "new_interval": [2, 5] }, "expected": [[1, 5], [6, 9]] },
    { "id": "basic-merge-several", "group": "basic", "input": { "intervals": [[1, 2], [3, 5], [6, 7], [8, 10], [12, 16]], "new_interval": [4, 8] }, "expected": [[1, 2], [3, 10], [12, 16]] },
    { "id": "basic-no-overlap-middle", "group": "basic", "input": { "intervals": [[1, 2], [8, 10]], "new_interval": [4, 6] }, "expected": [[1, 2], [4, 6], [8, 10]] },
    { "id": "basic-extends-left", "group": "basic", "input": { "intervals": [[1, 5], [10, 12]], "new_interval": [3, 8] }, "expected": [[1, 8], [10, 12]] },
    { "id": "basic-extends-right", "group": "basic", "input": { "intervals": [[1, 2], [6, 9], [20, 25]], "new_interval": [7, 14] }, "expected": [[1, 2], [6, 14], [20, 25]] },
    { "id": "edge-empty", "group": "edge", "input": { "intervals": [], "new_interval": [5, 7] }, "expected": [[5, 7]] },
    { "id": "edge-before-all", "group": "edge", "input": { "intervals": [[3, 5], [7, 9]], "new_interval": [0, 1] }, "expected": [[0, 1], [3, 5], [7, 9]] },
    { "id": "edge-after-all", "group": "edge", "input": { "intervals": [[1, 2], [3, 4]], "new_interval": [6, 8] }, "expected": [[1, 2], [3, 4], [6, 8]] },
    { "id": "edge-merges-last", "group": "edge", "input": { "intervals": [[1, 2], [5, 7]], "new_interval": [6, 9] }, "expected": [[1, 2], [5, 9]] },
    { "id": "edge-touching-both", "group": "edge", "input": { "intervals": [[1, 3], [6, 9]], "new_interval": [3, 6] }, "expected": [[1, 9]] },
    { "id": "edge-inside", "group": "edge", "input": { "intervals": [[1, 10], [12, 14]], "new_interval": [3, 4] }, "expected": [[1, 10], [12, 14]] },
    { "id": "edge-covers-all", "group": "edge", "input": { "intervals": [[2, 3], [5, 6], [8, 9]], "new_interval": [1, 10] }, "expected": [[1, 10]] },
    { "id": "edge-point", "group": "edge", "input": { "intervals": [[1, 2], [4, 5]], "new_interval": [3, 3] }, "expected": [[1, 2], [3, 3], [4, 5]] }
  ],
  "large": { "sizes": [100, 1000, 10000, 100000], "seed": 31 }
}
