{
  "id": "merge-intervals",
  "title": "Unirea intervalelor",
  "category": "sorting",
  "difficulty": "medium",
  "statement": "Se dă o listă de intervale `intervals`, unde fiecare interval este `[start, end]` cu `start ≤ end`. Unește toate intervalele care se suprapun și returnează lista de intervale rezultată.\n\nDouă intervale care se ating, de exemplu `[1, 4]` și `[4, 5]`, se consideră suprapuse. Ordinea intervalelor din rezultat nu contează.",
  "examples": [
    {
      "input": { "intervals": [[1, 3], [2, 6], [8, 10], [15, 18]] },
      "output": [[1, 6], [8, 10], [15, 18]],
      "explanation": "[1, 3] și [2, 6] se suprapun și devin [1, 6]."
    },
    { "input": { "intervals": [[1, 4], [4, 5]] }, "output": [[1, 5]] }
  ],
  "signature": {
    "function": "merge",
    "params": [{ "name": "intervals", "type": "list[list[int]]" }],
    "returns": "list[list[int]]"
  },
  "constraints": [
    "1 ≤ len(intervals) ≤ 10⁵",
    "0 ≤ start ≤ end ≤ 10⁹"
  ],
  "timeLimitMs": 1000,
  "comparator": "unordered",
  "forbiddenTerms": [
    { "term": "sortează", "allowedIfCode": "sort" },
    { "term": "sortare", "allowedIfCode": "sort" },
    { "term": "sortat", "allowedIfCode": "sort" },
    { "term": "sort", "allowedIfCode": "sort" },
    { "term": "ordonează", "allowedIfCode": "sort" },
    { "term": "ordonat", "allowedIfCode": "sort" },
    { "term": "după start", "allowedIfCode": "sort" },
    { "term": "maximul", "allowedIfCode": "max\\(" },
    { "term": "maximul capetelor" }
  ],
  "tests": [
    { "id": "basic-example", "group": "basic", "input": { "intervals": [[1, 3], [2, 6], [8, 10], [15, 18]] }, "expected": [[1, 6], [8, 10], [15, 18]] },
    { "id": "basic-no-overlap", "group": "basic", "input": { "intervals": [[1, 2], [5, 6], [9, 10]] }, "expected": [[1, 2], [5, 6], [9, 10]] },
    { "id": "basic-unsorted", "group": "basic", "input": { "intervals": [[8, 10], [1, 3], [2, 6]] }, "expected": [[1, 6], [8, 10]] },
    { "id": "basic-chain", "group": "basic", "input": { "intervals": [[1, 3], [2, 5], [4, 8], [7, 9]] }, "expected": [[1, 9]] },
    { "id": "edge-touching", "group": "edge", "input": { "intervals": [[1, 4], [4, 5]] }, "expected": [[1, 5]] },
    { "id": "edge-contained", "group": "edge", "input": { "intervals": [[1, 10], [2, 3], [4, 5]] }, "expected": [[1, 10]] },
    { "id": "edge-single", "group": "edge", "input": { "intervals": [[5, 7]] }, "expected": [[5, 7]] },
    { "id": "edge-point", "group": "edge", "input": { "intervals": [[3, 3], [3, 3], [1, 2]] }, "expected": [[1, 2], [3, 3]] },
    { "id": "edge-same-start", "group": "edge", "input": { "intervals": [[1, 4], [1, 2]] }, "expected": [[1, 4]] }
  ],
  "large": { "sizes": [100, 1000, 10000, 100000], "seed": 23 }
}
