{
  "id": "next-greater-element",
  "title": "Următorul element mai mare",
  "category": "stack",
  "difficulty": "medium",
  "statement": "Se dă un vector de numere întregi `nums`. Pentru fiecare poziție `i`, caută primul element aflat la dreapta lui `nums[i]` care este strict mai mare decât `nums[i]`.\n\nReturnează un vector de aceeași lungime, în care poziția `i` conține valoarea acelui element sau `-1` dacă la dreapta nu există niciun element strict mai mare. Un element egal cu `nums[i]` nu contează ca fiind mai mare.",
  "examples": [
    { "input": { "nums": [2, 1, 2, 4, 3] }, "output": [4, 2, 4, -1, -1], "explanation": "Pentru primul 2, valorile din dreapta sunt 1, 2, 4, 3; primul strict mai mare este 4. Nimic din dreapta lui 4 nu îl depășește, deci acolo apare -1." },
    { "input": { "nums": [6, 8, 0, 1, 3] }, "output": [8, -1, 1, 3, -1] }
  ],
  "signature": {
    "function": "next_greater",
    "params": [{ "name": "nums", "type": "list[int]" }],
    "returns": "list[int]"
  },
  "constraints": [
    "1 ≤ len(nums) ≤ 10⁵",
    "-10⁹ ≤ nums[i] ≤ 10⁹"
  ],
  "timeLimitMs": 500,
  "comparator": "exact",
  "forbiddenTerms": [
    { "term": "stivă", "allowedIfCode": "\\.append\\(|\\.pop\\(" },
    { "term": "stiva", "allowedIfCode": "\\.append\\(|\\.pop\\(" },
    { "term": "stack", "allowedIfCode": "\\.append\\(|\\.pop\\(" },
    { "term": "monoton" },
    { "term": "LIFO" },
    { "term": "push" },
    { "term": "pop", "allowedIfCode": "\\.pop\\(" },
    { "term": "vârful" },
    { "term": "în așteptare" },
    { "term": "încă nu și-au găsit" }
  ],
  "tests": [
    { "id": "basic-example", "group": "basic", "input": { "nums": [2, 1, 2, 4, 3] }, "expected": [4, 2, 4, -1, -1] },
    { "id": "basic-increasing", "group": "basic", "input": { "nums": [1, 2, 3, 4] }, "expected": [2, 3, 4, -1] },
    { "id": "basic-mixed", "group": "basic", "input": { "nums": [4, 5, 2, 25] }, "expected": [5, 25, 25, -1] },
    { "id": "basic-valley", "group": "basic", "input": { "nums": [6, 8, 0, 1, 3] }, "expected": [8, -1, 1, 3, -1] },
    { "id": "basic-negative", "group": "basic", "input": { "nums": [-3, -1, -2, 0] }, "expected": [-1, 0, 0, -1] },
    { "id": "edge-single", "group": "edge", "input": { "nums": [7] }, "expected": [-1] },
    { "id": "edge-decreasing", "group": "edge", "input": { "nums": [5, 4, 3, 2, 1] }, "expected": [-1, -1, -1, -1, -1] },
    { "id": "edge-all-equal", "group": "edge", "input": { "nums": [3, 3, 3] }, "expected": [-1, -1, -1] },
    { "id": "edge-equal-then-greater", "group": "edge", "input": { "nums": [2, 2, 1, 3] }, "expected": [3, 3, 3, -1] },
    { "id": "edge-skip-several", "group": "edge", "input": { "nums": [5, 1, 2, 3, 6] }, "expected": [6, 2, 3, 6, -1] },
    { "id": "edge-max-first", "group": "edge", "input": { "nums": [9, 1, 2, 3] }, "expected": [-1, 2, 3, -1] }
  ],
  "large": { "sizes": [100, 1000, 10000, 100000], "seed": 41 }
}
