{
  "id": "min-subarray-len",
  "title": "Cel mai scurt subvector cu suma minimă dată",
  "category": "two-pointers",
  "difficulty": "medium",
  "statement": "Se dau un număr întreg pozitiv `target` și o listă `nums` de numere întregi pozitive. Returnează lungimea celui mai scurt subvector de elemente **consecutive** din `nums` a cărui sumă este cel puțin `target`. Dacă nu există un astfel de subvector, returnează `0`.",
  "examples": [
    {"input": {"target": 9, "nums": [1, 4, 2, 5, 3, 1]}, "output": 3, "explanation": "[4, 2, 5] are suma 11 ≥ 9, iar nicio pereche de elemente vecine nu ajunge la 9."},
    {"input": {"target": 20, "nums": [3, 4, 5]}, "output": 0, "explanation": "Suma tuturor elementelor este 12, mai mică decât 20."}
  ],
  "signature": {"function": "min_subarray_len", "params": [{"name": "target", "type": "int"}, {"name": "nums", "type": "list[int]"}], "returns": "int"},
  "constraints": [
    "1 ≤ target ≤ 10⁹",
    "1 ≤ len(nums) ≤ 10⁵",
    "1 ≤ nums[i] ≤ 10⁴"
  ],
  "timeLimitMs": 1000,
  "comparator": "exact",
  "forbiddenTerms": [
    {"term": "fereastră", "allowedIfCode": "left|start"},
    {"term": "sliding"},
    {"term": "window"},
    {"term": "doi pointeri", "allowedIfCode": "left|start"},
    {"term": "two pointers", "allowedIfCode": "left|start"},
    {"term": "pointer", "allowedIfCode": "left|start"},
    {"term": "sume parțiale"},
    {"term": "prefix"},
    {"term": "căutare binară"},
    {"term": "binary search"},
    {"term": "micșorează"},
    {"term": "restrânge"}
  ],
  "tests": [
    {"id": "basic-example", "group": "basic", "input": {"target": 9, "nums": [1, 4, 2, 5, 3, 1]}, "expected": 3},
    {"id": "basic-whole-array", "group": "basic", "input": {"target": 15, "nums": [1, 2, 3, 4, 5]}, "expected": 5},
    {"id": "basic-one-element", "group": "basic", "input": {"target": 4, "nums": [1, 4, 1, 1]}, "expected": 1},
    {"id": "basic-at-end", "group": "basic", "input": {"target": 12, "nums": [1, 1, 1, 1, 6, 6]}, "expected": 2},
    {"id": "basic-middle", "group": "basic", "input": {"target": 11, "nums": [2, 1, 6, 5, 1, 2]}, "expected": 2},
    {"id": "edge-impossible", "group": "edge", "input": {"target": 100, "nums": [1, 2, 3]}, "expected": 0},
    {"id": "edge-single-enough", "group": "edge", "input": {"target": 5, "nums": [5]}, "expected": 1},
    {"id": "edge-single-short", "group": "edge", "input": {"target": 6, "nums": [5]}, "expected": 0},
    {"id": "edge-exact-total", "group": "edge", "input": {"target": 6, "nums": [1, 2, 3]}, "expected": 3},
    {"id": "edge-big-last", "group": "edge", "input": {"target": 7, "nums": [1, 1, 1, 1, 7]}, "expected": 1}
  ],
  "large": {"sizes": [100, 1000, 10000, 100000], "seed": 43}
}
