{
  "id": "min-eating-speed",
  "title": "Viteza minimă de mâncat",
  "category": "binary-search",
  "difficulty": "medium",
  "statement": "O maimuță are în față mai multe grămezi de banane; grămada `i` are `piles[i]` banane. Ea alege o viteză întreagă `k` (banane pe oră) și mănâncă astfel: în fiecare oră alege o singură grămadă și mănâncă din ea cel mult `k` banane. Dacă grămada are mai puțin de `k` banane, o termină și nu mai mănâncă nimic până la sfârșitul acelei ore.\n\nAstfel, o grămadă cu `p` banane îi ia `⌈p / k⌉` ore. Returnează cea mai mică viteză `k` pentru care maimuța termină toate grămezile în cel mult `h` ore.",
  "examples": [
    { "input": { "piles": [3, 6, 7, 11], "h": 8 }, "output": 4, "explanation": "Cu k = 4 îi trebuie 1 + 2 + 2 + 3 = 8 ore. Cu k = 3 i-ar trebui 1 + 2 + 3 + 4 = 10 ore, prea mult." },
    { "input": { "piles": [8, 3, 5], "h": 3 }, "output": 8, "explanation": "Are câte o oră pentru fiecare grămadă, deci trebuie să termine și grămada cea mai mare într-o oră." }
  ],
  "signature": {
    "function": "min_eating_speed",
    "params": [{ "name": "piles", "type": "list[int]" }, { "name": "h", "type": "int" }],
    "returns": "int"
  },
  "constraints": [
    "1 ≤ len(piles) ≤ 10⁵",
    "1 ≤ piles[i] ≤ 10⁹",
    "len(piles) ≤ h ≤ 10⁹"
  ],
  "timeLimitMs": 1000,
  "comparator": "exact",
  "forbiddenTerms": [
    { "term": "căutare binară" },
    { "term": "binary search" },
    { "term": "binar" },
    { "term": "bisect" },
    { "term": "jumătate", "allowedIfCode": "//\\s*2" },
    { "term": "înjumătățește" },
    { "term": "mijloc", "allowedIfCode": "mid|\\(\\s*lo\\s*\\+\\s*hi\\s*\\)" },
    { "term": "monoton" },
    { "term": "căutare pe răspuns" },
    { "term": "logaritm" }
  ],
  "tests": [
