    { "id": "basic-more-time", "group": "basic", "input": { "piles": [12, 7, 9], "h": 12 }, "expected": 3 },
    { "id": "basic-repeated", "group": "basic", "input": { "piles": [6, 6, 6, 6], "h": 9 }, "expected": 3 },
