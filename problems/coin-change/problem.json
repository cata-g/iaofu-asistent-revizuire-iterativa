{
  "id": "coin-change",
  "title": "Restul cu cele mai puține monede",
  "category": "dp",
  "difficulty": "medium",
  "statement": "Ai la dispoziție monede cu valorile din lista `coins`, din fiecare valoare câte monede vrei. Vrei să plătești exact suma `amount`.\n\nReturnează numărul minim de monede a căror valoare totală este exact `amount`. Dacă suma nu poate fi formată, returnează `-1`. Pentru `amount = 0` răspunsul este `0` (nu folosești nicio monedă).",
  "examples": [
    {"input": {"coins": [1, 4, 6], "amount": 8}, "output": 2, "explanation": "8 = 4 + 4. Dacă iei întâi moneda cea mai mare, ajungi la 6 + 1 + 1, adică 3 monede."},
    {"input": {"coins": [4, 6], "amount": 9}, "output": -1, "explanation": "Orice combinație de monede de 4 și 6 dă o sumă pară."}
  ],
  "signature": {"function": "coin_change", "params": [{"name": "coins", "type": "list[int]"}, {"name": "amount", "type": "int"}], "returns": "int"},
  "constraints": [
    "1 ≤ len(coins) ≤ 12",
    "1 ≤ coins[i] ≤ 10⁴, valori distincte",
    "0 ≤ amount ≤ 10⁵"
  ],
  "timeLimitMs": 1500,
  "comparator": "exact",
  "forbiddenTerms": [
    {"term": "programare dinamică"},
    {"term": "dinamic"},
